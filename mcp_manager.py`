import os
import json
import shutil
from datetime import datetime

# リバにゃんが定義した最強のパック群だにゃ！
PACKS = {
    "starter-pack": [
        {"name": "web-search-mcp", "url": "https://github.com/modelcontextprotocol/servers/tree/main/src/web-search", "type": "http", "description": "Web検索機能を提供するMCPサーバー"},
        {"name": "file-ops-mcp", "url": "https://github.com/modelcontextprotocol/servers/tree/main/src/filesystem", "type": "http", "description": "ファイル操作・管理用MCPサーバー"},
        {"name": "code-gen-mcp", "url": "https://github.com/modelcontextprotocol/servers/tree/main/src/code-generator", "type": "http", "description": "コード生成・デバッグ支援用MCPサーバー"},
    ],
    "earning-pack": [
        {"name": "line-bot-mcp", "url": "https://github.com/your-org/line-bot-mcp", "type": "http", "description": "LINE Bot連携テンプレ（Dify統合）"},
        {"name": "automation-mcp", "url": "https://github.com/your-org/automation-mcp", "type": "http", "description": "自動化・リサーチ＆記事生成パック"},
        {"name": "analytics-mcp", "url": "https://github.com/your-org/analytics-mcp", "type": "http", "description": "データ分析・レポート自動生成用MCPサーバー"},
    ]
}

class MCPManager:
    def __init__(self):
        self.config_path = self._get_config_path()
    
    def _get_config_path(self):
        if os.name == 'posix':
            if os.environ.get('MCP_CONFIG_PATH'):
                return os.environ['MCP_CONFIG_PATH']
            return os.path.expanduser('~/Library/Application Support/Claude/claude_desktop_config.json')
        elif os.name == 'nt':
            if os.environ.get('MCP_CONFIG_PATH'):
                return os.environ['MCP_CONFIG_PATH']
            return os.path.join(os.environ['APPDATA'], 'Claude', 'claude_desktop_config.json')
        else:
            raise OSError("Unsupported operating system")
    
    def _load_config(self):
        if not os.path.exists(self.config_path):
            return {"mcpServers": {}}
        with open(self.config_path, 'r', encoding='utf-8') as f:
            return json.load(f)
    
    def _save_config(self, config):
        os.makedirs(os.path.dirname(self.config_path), exist_ok=True)
        with open(self.config_path, 'w', encoding='utf-8') as f:
            json.dump(config, f, indent=4, ensure_ascii=False)
    
    def backup_config(self):
        if os.path.exists(self.config_path):
            timestamp = datetime.now().strftime("%Y%m%d%H%M%S")
            backup_path = f"{self.config_path}.bak.{timestamp}"
            shutil.copy2(self.config_path, backup_path)
            print(f"✅ Configuration backed up to: {backup_path}")
            return backup_path
        return None
    
    def add_mcp_server(self, name, url, type="http", description=""):
        config = self._load_config()
        if "mcpServers" not in config:
            config["mcpServers"] = {}
        config["mcpServers"][name] = {"url": url, "type": type, "description": description}
        self._save_config(config)
        print(f"✅ MCP server '{name}' added successfully.")
        return True

    def install_pack(self, pack_name):
        pack = PACKS.get(pack_name)
        if not pack:
            print("Pack not found")
            return
        for server in pack:
            self.add_mcp_server(**server)

    def list_mcp_servers(self):
        config = self._load_config()
        servers = config.get("mcpServers", {})
        print("🐾 Configured MCP Servers:")
        for name in servers:
            print(f"  - {name}")
        return list(servers.keys())
